{
  "name": "ContactSubmission",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the person who submitted the contact form"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Reply-to email address"
    },
    "subject": {
      "type": "string",
      "description": "Subject of the enquiry"
    },
    "message": {
      "type": "string",
      "description": "Message body from the website contact form"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "read",
        "archived"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "gray"
      ],
      "default": "new",
      "description": "Review status"
    }
  },
  "required": [
    "name",
    "email",
    "subject",
    "message"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}