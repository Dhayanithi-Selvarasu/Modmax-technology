{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Anonymous visitor session identifier"
    },
    "user_message": {
      "type": "string",
      "description": "What the visitor asked"
    },
    "ai_response": {
      "type": "string",
      "description": "The assistant's reply"
    }
  },
  "required": [
    "session_id",
    "user_message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}